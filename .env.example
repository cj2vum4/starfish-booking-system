# Values are entered in Supabase Edge Function Secrets, never in source code.
LINE_CHANNEL_SECRET=
# Required later for profile retrieval and LINE notifications.
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF sign-in (api function). Channel ID and LIFF ID are public identifiers.
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
# Comma-separated HTTPS origins allowed to call the api function, e.g. the LIFF host.
ALLOWED_ORIGINS=
# Google service account key (JSON) with "See only free/busy" access to the store calendar.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar to check, usually the owner's Gmail address.
GOOGLE_CALENDAR_ID=
# Dedicated store calendar that confirmed sessions are written to (service account: Make changes to events).
GOOGLE_EVENTS_CALENDAR_ID=
# Google Sheet that the store report is exported to (service account: Editor). The ID is not secret.
GOOGLE_SHEET_ID=
# Published .ics calendars whose busy times also block bookings (e.g. Outlook). Secret: the URL grants read access.
BUSY_ICS_URLS=
# Shared with the starfishlarp GitHub Action secret BOOKING_SYNC_SECRET (catalog auto-sync).
CATALOG_SYNC_SECRET=
# Automatically injected into Supabase Edge Functions by the platform.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
